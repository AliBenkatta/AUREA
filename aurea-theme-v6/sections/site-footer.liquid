<footer class="on-dark">
  {%- if section.settings.show_newsletter -%}
  <section class="section-tight">
    <div class="container newsletter-wrap reveal">
      <div>
        <span class="eyebrow">{{ section.settings.nl_eyebrow }}</span>
        <h2 class="h-2" style="margin-top:18px;">{{ section.settings.nl_heading }}</h2>
      </div>
      {% form 'customer', class: 'nl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="your email address" aria-label="Email" required>
        <button type="submit"><span>Subscribe</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
        </button>
        {%- if form.posted_successfully? -%}
          <p class="label-mono" style="color:var(--gold);">Welcomed. Check your inbox.</p>
        {%- endif -%}
      {% endform %}
    </div>
  </section>
  <div class="divider" style="margin-top:20px;"></div>
  {%- endif -%}

  <div class="container footer">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="wordmark">
          {%- if section.settings.logo_image_dark != blank -%}
            <img class="mark" src="{{ section.settings.logo_image_dark | image_url: width: 80 }}" alt="{{ section.settings.brand_name | default: shop.name }}" width="32" height="32">
          {%- else -%}
            <img class="mark" src="{{ 'aurea-mark-light.png' | asset_url }}" alt="{{ section.settings.brand_name | default: shop.name }}" width="32" height="32">
          {%- endif -%}
          {{ section.settings.brand_name | default: shop.name }}
        </a>
        <p>{{ section.settings.blurb }}</p>
        <div class="footer-social">
          {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1"/></svg></a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 3v10.6a3.6 3.6 0 1 1-3-3.55V7.2a6.2 6.2 0 1 0 5 6.08V9.7a5.6 5.6 0 0 0 3 .88V7.3A4.6 4.6 0 0 1 16.6 3H14Z"/></svg></a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
      <div class="footer-col">
        <h5>{{ block.settings.title }}</h5>
        <ul>
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.tagline }}</p>
      <div class="footer-legal">
        <a href="{{ routes.root_url }}policies/privacy-policy">Privacy Policy</a>
        <a href="{{ routes.root_url }}policies/terms-of-service">Terms</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Wordmark text", "default": "AUR\u00c9A" },
    { "type": "image_picker", "id": "logo_image_dark", "label": "Logo mark for dark background (optional \u2014 defaults to the bundled light-gold AUR\u00c9A mark)" },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Single-origin Moroccan argan oil. One ingredient, cold-pressed in Agadir and bottled without compromise." },
    { "type": "text", "id": "tagline", "label": "Copyright tagline", "default": "Nature, Elevated." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "nl_eyebrow", "label": "Eyebrow", "default": "Join the Field Notes" },
    { "type": "text", "id": "nl_heading", "label": "Heading", "default": "Occasional dispatches on Moroccan argan, skincare ritual, and new specimens." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "Shop" } },
      { "type": "menu", "settings": { "title": "Study" } },
      { "type": "menu", "settings": { "title": "Connect" } }
    ]
  }
}
{% endschema %}
