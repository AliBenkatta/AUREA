<section class="section" id="reviews">
  <div class="container">
    <div class="reveal" style="margin-bottom:44px;">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-2" style="margin-top:18px;">{{ section.settings.heading }}</h2>
    </div>
    <div class="reviews-scroller reveal">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="stars"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.8 1.7 7-6.3-3.9L5.7 21l1.7-7L2 9.2l7.1-.6L12 2Z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.8 1.7 7-6.3-3.9L5.7 21l1.7-7L2 9.2l7.1-.6L12 2Z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.8 1.7 7-6.3-3.9L5.7 21l1.7-7L2 9.2l7.1-.6L12 2Z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.8 1.7 7-6.3-3.9L5.7 21l1.7-7L2 9.2l7.1-.6L12 2Z"/></svg><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.8 1.7 7-6.3-3.9L5.7 21l1.7-7L2 9.2l7.1-.6L12 2Z"/></svg></div>
          <p class="quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          <div class="review-meta">
            <div class="initial">{{ block.settings.name | slice: 0, 1 }}</div>
            <span>{{ block.settings.name }}{% if block.settings.verified %} &mdash; Verified Buyer{% endif %}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="scroller-controls">
      <button class="scroller-btn" data-scroll="prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="scroller-btn" data-scroll="next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Field Reports" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the bottle earns in daily use." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Two drops, every night." },
        { "type": "text", "id": "name", "label": "Name", "default": "Heba A." },
        { "type": "checkbox", "id": "verified", "label": "Show \u201cVerified Buyer\u201d", "default": true }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "review", "settings": { "quote": "Two drops, every night. My skin stopped tightening in the Michigan winter for the first time in years.", "name": "Heba A." } },
      { "type": "review", "settings": { "quote": "I stopped counting how many products I was layering. This replaced four of them and my beard has never felt better.", "name": "Samer E." } },
      { "type": "review", "settings": { "quote": "The Certificate of Analysis is what sold me \u2014 not a marketing claim, an actual lab report. Rare in this category.", "name": "Rola F." } },
      { "type": "review", "settings": { "quote": "Fragrance-free actually means fragrance-free. Layers under my SPF with zero pilling.", "name": "Maha F." } }
    ]
  },
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
