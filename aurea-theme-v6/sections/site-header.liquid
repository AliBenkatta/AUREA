<header class="site-header">
  <div class="container nav-row">
    <a href="{{ routes.root_url }}" class="wordmark">
      {%- if section.settings.logo_image != blank -%}
        <img class="mark" src="{{ section.settings.logo_image | image_url: width: 80 }}" alt="{{ section.settings.brand_name | default: shop.name }}" width="32" height="32">
      {%- else -%}
        <img class="mark" src="{{ 'aurea-mark.png' | asset_url }}" alt="{{ section.settings.brand_name | default: shop.name }}" width="32" height="32">
      {%- endif -%}
      {{ section.settings.brand_name | default: shop.name }}
    </a>

    <nav class="nav-links" role="navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="nav-right">
      <a href="{{ routes.cart_url }}" class="nav-icon-btn" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 6h2l2.2 11.4A2 2 0 0 0 9.16 19h8.5a2 2 0 0 0 1.96-1.6L21 8H6"/><circle cx="10" cy="21.5" r="1"/><circle cx="18" cy="21.5" r="1"/></svg>
        <span class="cart-count{% if cart.item_count > 0 %} show{% endif %}">{{ cart.item_count }}</span>
      </a>
      <button class="menu-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Wordmark text", "default": "AUR\u00c9A" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo mark (optional \u2014 defaults to the bundled AUR\u00c9A mark)" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
