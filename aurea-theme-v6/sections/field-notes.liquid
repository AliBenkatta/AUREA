{%- assign blog = blogs[section.settings.blog] -%}
<section class="section" style="background:var(--bone-dim);">
  <div class="container">
    <div class="reveal" style="margin-bottom:44px; display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:20px;">
      <div>
        <span class="eyebrow eyebrow-olive">{{ section.settings.eyebrow }}</span>
        <h2 class="h-2" style="margin-top:18px;">{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a href="{{ blog.url }}" class="btn btn-ghost">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
    <div class="post-grid reveal-stagger">
      {%- for article in blog.articles limit: 3 -%}
        <a href="{{ article.url }}" class="post-card{% if forloop.first %} featured{% endif %}">
          <div class="post-thumb">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | escape }}" width="900" height="600" style="width:100%;height:100%;object-fit:cover;" loading="lazy">
            {%- else -%}
              <svg viewBox="0 0 400 225" preserveAspectRatio="xMidYMid slice"><rect width="400" height="225" fill="#1B1512"/><circle cx="330" cy="55" r="26" fill="#C9A15C" opacity="0.85"/><path d="M0,190 L60,120 L110,170 L170,90 L230,170 L290,110 L340,170 L400,140 L400,225 L0,225 Z" fill="#3B4429"/><path d="M0,205 L80,150 L150,190 L220,130 L290,190 L360,150 L400,175 L400,225 L0,225 Z" fill="#57633F" opacity="0.7"/></svg>
            {%- endif -%}
          </div>
          <span class="post-cat">{{ article.tags.first | default: 'Field Note' }}</span>
          <h3>{{ article.title }}</h3>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          <span class="post-read">Read the Note <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span>
        </a>
      {%- endfor -%}
    </div>
    {%- else -%}
      <p class="body-text">Publish articles to your <strong>{{ section.settings.blog | default: 'news' }}</strong> blog and they will appear here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Field Notes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Field Notes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dispatches on origin and ritual." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Read All Notes" }
  ],
  "presets": [{ "name": "Field Notes" }]
}
{% endschema %}
