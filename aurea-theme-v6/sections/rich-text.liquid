<section class="section{% if section.settings.dark %} on-dark{% endif %}">
  <div class="container" style="max-width:820px; text-align:{{ section.settings.align }};">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow"{% if section.settings.align == 'center' %} style="justify-content:center;"{% endif %}>{{ section.settings.eyebrow }}</span>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h-1" style="margin:20px 0 20px;">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte body-text" style="font-size:17px;">{{ section.settings.text }}</div>
    {%- if section.settings.cta_text != blank -%}
      <a href="{{ section.settings.cta_link }}" class="btn btn-primary" style="margin-top:28px;">{{ section.settings.cta_text }} <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}] },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false },
    { "type": "text", "id": "cta_text", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
