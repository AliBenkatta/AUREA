<section class="section" style="padding-top:clamp(140px,16vw,180px);">
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px; margin-bottom:40px;">
        <div>
          <span class="eyebrow">Your Selection</span>
          <h1 class="h-1" style="margin-top:18px;">Cart</h1>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="post-read">Continue shopping</a>
      </div>

      {% form 'cart', cart %}
        {%- for item in cart.items -%}
          <div class="cart-row">
            <div class="cart-thumb">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" width="300" height="300" loading="lazy">
              {%- else -%}
                {% render 'bottle-mini' %}
              {%- endif -%}
            </div>

            <div>
              <a href="{{ item.url }}" class="cart-title">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}
                <div class="cart-variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-variant">{{ item.original_price | money }} each</div>
              <a href="{{ item.url_to_remove }}" class="cart-remove">Remove</a>
            </div>

            <div class="qty-stepper">
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" style="width:40px;height:44px;display:flex;align-items:center;justify-content:center;">&minus;</a>
              <input type="text" value="{{ item.quantity }}" aria-label="Quantity" readonly style="width:40px;">
              <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" style="width:40px;height:44px;display:flex;align-items:center;justify-content:center;">+</a>
            </div>

            <div style="font-family:var(--f-mono); font-size:15px; min-width:90px; text-align:right;">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}

        <div class="cart-summary">
          <div class="cart-subtotal">
            <span class="label-mono">Subtotal</span>
            <span class="amt">{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-note">Taxes and shipping calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn-primary" style="min-width:260px; justify-content:center;">Checkout <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg></button>
        </div>
      {% endform %}

    {%- else -%}
      <div class="cart-empty">
        <span class="eyebrow" style="justify-content:center;">Empty</span>
        <h1 class="h-1" style="margin:22px 0 18px;">Nothing here yet.</h1>
        <p class="lede" style="max-width:440px; margin:0 auto 32px;">One bottle. One ingredient. Fifty millilitres of Agadir.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Shop the Oil <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
