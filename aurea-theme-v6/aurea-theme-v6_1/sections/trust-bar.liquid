<section class="trust-bar">
  <div class="container trust-grid">
    {%- for block in section.blocks -%}
      <div class="trust-item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}{%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3C12 3 6 11 6 15a6 6 0 0 0 12 0c0-4-6-12-6-12Z"/></svg>{%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 19c8 0 14-6 14-14 0 0-11-1-14 6-2 4-1 6 0 8Z"/><path d="M5 19c2-4 5-7 9-9"/></svg>{%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>{%- when 'pin' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"/></svg>{%- when 'doc' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M7 3h10l2 4v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7l2-4Z"/><path d="M9 11h6M9 15h6"/></svg>{%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 20.5S3.5 15.4 3.5 9.4A4.9 4.9 0 0 1 12 6.2a4.9 4.9 0 0 1 8.5 3.2c0 6-8.5 11.1-8.5 11.1Z"/></svg>{%- endcase -%}
        <div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "drop", "options": [{"value": "drop", "label": "Drop"}, {"value": "leaf", "label": "Leaf"}, {"value": "shield", "label": "Shield"}, {"value": "pin", "label": "Pin"}, {"value": "doc", "label": "Doc"}, {"value": "heart", "label": "Heart"}] },
        { "type": "text", "id": "title", "label": "Title", "default": "100% Pure" },
        { "type": "text", "id": "text", "label": "Text", "default": "No additives, ever" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "drop", "title": "100% Pure", "text": "No additives, ever" } },
      { "type": "item", "settings": { "icon": "leaf", "title": "Cold-Pressed", "text": "Unrefined & natural" } },
      { "type": "item", "settings": { "icon": "shield", "title": "USDA Organic", "text": "Certified purity" } },
      { "type": "item", "settings": { "icon": "pin", "title": "Single-Origin", "text": "Agadir, Morocco" } }
    ]
  },
  "presets": [{ "name": "Trust bar" }]
}
{% endschema %}
