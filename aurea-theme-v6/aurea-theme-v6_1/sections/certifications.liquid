<section class="section" id="certifications" style="padding-top:0;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
    <div class="reveal" style="max-width:620px; margin-bottom:46px;">
      <span class="eyebrow eyebrow-olive">{{ section.settings.eyebrow }}</span>
      <h2 class="h-2" style="margin-top:18px;">{{ section.settings.heading }}</h2>
    </div>
    {%- endif -%}
    <div class="cert-grid reveal">
      {%- for block in section.blocks -%}
        <div class="cert-card" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}{%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3C12 3 6 11 6 15a6 6 0 0 0 12 0c0-4-6-12-6-12Z"/></svg>{%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 19c8 0 14-6 14-14 0 0-11-1-14 6-2 4-1 6 0 8Z"/><path d="M5 19c2-4 5-7 9-9"/></svg>{%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>{%- when 'pin' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12Z"/></svg>{%- when 'doc' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M7 3h10l2 4v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7l2-4Z"/><path d="M9 11h6M9 15h6"/></svg>{%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 20.5S3.5 15.4 3.5 9.4A4.9 4.9 0 0 1 12 6.2a4.9 4.9 0 0 1 8.5 3.2c0 6-8.5 11.1-8.5 11.1Z"/></svg>{%- endcase -%}
          <div><h4>{{ block.settings.title }}</h4><p>{{ block.settings.text }}</p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Certifications",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verification" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" }
  ],
  "blocks": [
    {
      "type": "cert",
      "name": "Certification",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [{"value": "drop", "label": "Drop"}, {"value": "leaf", "label": "Leaf"}, {"value": "shield", "label": "Shield"}, {"value": "pin", "label": "Pin"}, {"value": "doc", "label": "Doc"}, {"value": "heart", "label": "Heart"}] },
        { "type": "text", "id": "title", "label": "Title", "default": "USDA Certified Organic" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Certified by the U.S. Department of Agriculture \u2014 verifying the oil is grown and processed without synthetic pesticides or additives." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "cert", "settings": { "icon": "shield", "title": "USDA Certified Organic", "text": "Certified by the U.S. Department of Agriculture \u2014 verifying the oil is grown and processed without synthetic pesticides or additives." } },
      { "type": "cert", "settings": { "icon": "doc", "title": "Certificate of Analysis", "text": "Every batch is independently lab-tested for purity and potency \u2014 the report ships with proof, not just a promise." } },
      { "type": "cert", "settings": { "icon": "heart", "title": "Vegan & Cruelty-Free", "text": "No animal-derived ingredients, no animal testing \u2014 at any stage, from grove to bottle." } },
      { "type": "cert", "settings": { "icon": "leaf", "title": "Sustainably Sourced", "text": "Fair-wage partnership with a women's argan cooperative in Agadir's UNESCO biosphere reserve." } }
    ]
  },
  "presets": [{ "name": "Certifications" }]
}
{% endschema %}
