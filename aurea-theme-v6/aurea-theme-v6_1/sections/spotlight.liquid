<section class="section">
  <div class="container spotlight-grid">
    <div class="reveal">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="900" loading="lazy" style="width:100%;">
      {%- else -%}
        <svg viewBox="0 0 260 320" width="100%">
          <defs><linearGradient id="spotGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#C98C4C"/><stop offset="1" stop-color="#7A4A1F"/></linearGradient></defs>
          <circle cx="130" cy="160" r="120" fill="none" stroke="#A6672B" stroke-opacity="0.18"/>
          <circle cx="130" cy="60" r="2" fill="#57633F"/><circle cx="220" cy="160" r="2" fill="#57633F"/>
          <circle cx="130" cy="260" r="2" fill="#57633F"/><circle cx="40" cy="160" r="2" fill="#57633F"/>
          <path d="M130 100 L130 220 M85 130 L175 190 M175 130 L85 190" stroke="#A6672B" stroke-width="1" stroke-opacity="0.35"/>
          <circle cx="130" cy="160" r="46" fill="url(#spotGrad)" opacity="0.92"/>
        </svg>
      {%- endif -%}
    </div>
    <div class="reveal">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h-2" style="margin:18px 0 22px;">{{ section.settings.heading }}</h2>
      <p class="body-text" style="max-width:480px;">{{ section.settings.text }}</p>
      <div class="check-list">
        {%- for block in section.blocks -%}
          <div class="check-item" {{ block.shopify_attributes }}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12l5 5L20 6"/></svg>{{ block.settings.text }}</div>
        {%- endfor -%}
      </div>
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link }}" class="btn btn-primary">{{ section.settings.cta_text }} <svg class="btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "One Elixir" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Infinite ritual, from a single bottle." },
    { "type": "textarea", "id": "text", "label": "Body", "default": "AUR\u00c9A absorbs into skin, hair, beard, and cuticle alike \u2014 because unrefined argan oil doesn't need reformulating for each. Fewer products, used more deliberately, is the whole idea." },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Shop the Oil" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Benefit", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Softens and hydrates skin without clogging pores" } ] }
  ],
  "default": {
    "blocks": [
      { "type": "benefit", "settings": { "text": "Softens and hydrates skin without clogging pores" } },
      { "type": "benefit", "settings": { "text": "Tames frizz and restores natural shine to hair" } },
      { "type": "benefit", "settings": { "text": "Conditions beard and softens cuticles" } },
      { "type": "benefit", "settings": { "text": "Fragrance-free \u2014 layers under any routine" } }
    ]
  },
  "presets": [{ "name": "Product spotlight" }]
}
{% endschema %}
