<section class="hero" style="padding-bottom:0;">
  <div class="container">
    <div class="breadcrumb" style="margin-bottom:28px;"><a href="{{ routes.root_url }}">Home</a> <span>/</span> <span>{{ collection.title }}</span></div>
    <span class="eyebrow">The Collection</span>
    <h1 class="h-display" style="margin:22px 0 26px;">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="lede rte" style="max-width:620px;">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

<section class="section">
  <div class="container">
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="product-grid reveal-stagger">
          {%- for product in collection.products -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div style="text-align:center; padding:60px 0;">
          <h2 class="h-2">No products here yet.</h2>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
