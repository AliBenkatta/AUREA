<section class="section" style="padding-top:clamp(140px,16vw,180px);">
  <div class="container" style="max-width:460px;">
    <h1 class="h-2" style="margin-bottom:26px;">Reset password</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="form-field"><label for="np">New password</label><input type="password" name="customer[password]" id="np"></div>
      <div class="form-field"><label for="nc">Confirm</label><input type="password" name="customer[password_confirmation]" id="nc"></div>
      <button type="submit" class="btn btn-primary btn-block">Reset</button>
    {% endform %}
  </div>
</section>