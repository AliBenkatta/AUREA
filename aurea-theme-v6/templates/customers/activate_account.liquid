<section class="section" style="padding-top:clamp(140px,16vw,180px);">
  <div class="container" style="max-width:460px;">
    <h1 class="h-2" style="margin-bottom:26px;">Activate account</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="form-field"><label for="ap">Password</label><input type="password" name="customer[password]" id="ap"></div>
      <div class="form-field"><label for="ac">Confirm</label><input type="password" name="customer[password_confirmation]" id="ac"></div>
      <button type="submit" class="btn btn-primary btn-block">Activate</button>
      <button type="submit" name="decline" class="btn btn-ghost btn-block" style="margin-top:12px;">Decline</button>
    {% endform %}
  </div>
</section>