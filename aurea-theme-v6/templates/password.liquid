<section class="section" style="text-align:center; padding-top:120px;">
  <div class="container">
    <span class="eyebrow" style="justify-content:center;">Opening Soon</span>
    <h1 class="h-display" style="margin:24px 0 20px;">AURÉA</h1>
    <p class="lede" style="max-width:420px; margin:0 auto 34px;">Single-origin Moroccan argan oil. Launching shortly.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="form-field" style="max-width:320px;margin:0 auto 16px;">
        <label for="pw">Enter store password</label>
        <input type="password" name="password" id="pw">
      </div>
      <button type="submit" class="btn btn-primary">Enter</button>
    {% endform %}
  </div>
</section>
