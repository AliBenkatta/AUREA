<a href="{{ card_product.url }}" class="product-card">
  <div class="product-card-media">
    {%- if card_product.featured_image -%}
      <img src="{{ card_product.featured_image | image_url: width: 600 }}"
           alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
           width="600" height="600" loading="lazy">
    {%- else -%}
      {% render 'bottle-mini' %}
    {%- endif -%}
  </div>
  <h3>{{ card_product.title }}</h3>
  <div class="price">
    {%- if card_product.compare_at_price > card_product.price -%}
      <span class="price-sale">{{ card_product.price | money }}</span>
      <span class="price-compare">{{ card_product.compare_at_price | money }}</span>
    {%- else -%}
      {{ card_product.price | money }}
    {%- endif -%}
  </div>
</a>
